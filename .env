# ============================================
# GestStore - Variables de Entorno
# ============================================
# Archivo para importar en Digital Ocean App Platform
# App Platform > Settings > App-Level Environment Variables > Bulk Editor

# ============================================
# DIGITAL OCEAN - PRODUCCIÓN
# ============================================
# Copiar desde la línea de abajo para pegar en Digital Ocean

# --------------------------------------------
# VARIABLES PARA EL BACKEND (Spring Boot)
# --------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATA_MONGODB_URI=mongodb+srv://doadmin:6edC318c2f50Xi4T@db-mongodb-nyc3-81705-8b13c7cb.mongo.ondigitalocean.com/admin?tls=true&authSource=admin&replicaSet=db-mongodb-nyc3-81705
MONGODB_DATABASE=geststore
JAVA_OPTS=-Xms256m -Xmx512m

# --------------------------------------------
# FRONTEND (Angular/Nginx)
# --------------------------------------------
# URL del backend para llamadas API (si usas servicios separados)
# Obtener desde: Digital Ocean > Apps > Tu app > Backend service > URL
API_URL=https://TU-BACKEND-XXXXX.ondigitalocean.app

# Puerto del frontend
PORT=80

# ============================================
# INSTRUCCIONES DIGITAL OCEAN
# ============================================
# 
# 1. Ve a: Digital Ocean > Apps > Tu App > Settings
#
# 2. Para el BACKEND, añade estas variables:
#    - SPRING_PROFILES_ACTIVE = prod
#    - SPRING_DATA_MONGODB_URI = (tu connection string de MongoDB)
#    - MONGODB_DATABASE = geststore
#    - JAVA_OPTS = -Xms256m -Xmx512m
#
# 3. Para el FRONTEND (si es servicio separado):
#    - API_URL = https://url-de-tu-backend.ondigitalocean.app
#
# 4. Obtener Connection String de MongoDB:
#    Digital Ocean > Databases > Tu cluster MongoDB > 
#    Connection Details > Connection String
#
# ============================================

