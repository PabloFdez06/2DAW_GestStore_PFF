# ============================================
# GestStore - Variables de Entorno
# ============================================
# Copia este archivo a .env y ajusta los valores según tu entorno

# ============================================
# Base de Datos MySQL
# ============================================
DB_ROOT_PASSWORD=rootpass
DB_NAME=geststore_dev
DB_USER=geststore
DB_PASSWORD=geststore123
DB_PORT=3306

# ============================================
# Backend Spring Boot
# ============================================
BACKEND_PORT=8080
SPRING_PROFILE=prod
# Opciones de Java (ajustar según necesidades de memoria)
JAVA_OPTS=-Xms256m -Xmx512m

# ============================================
# Frontend Angular
# ============================================
FRONTEND_PORT=80

# ============================================
# Adminer (Gestor de Base de Datos)
# ============================================
ADMINER_PORT=8081

# ============================================
# Configuración de Producción
# ============================================
# Para producción, cambiar estos valores:
# - Usar contraseñas seguras y complejas
# - Cambiar SPRING_PROFILE a 'prod'
# - Ajustar JAVA_OPTS según recursos del servidor
# - Considerar usar secretos en lugar de variables de entorno