# --------------------------------------------
# VARIABLES PARA EL BACKEND (Spring Boot)
# --------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATA_MONGODB_URI=mongodb+srv://doadmin:6edC318c2f50Xi4T@db-mongodb-nyc3-81705-8b13c7cb.mongo.ondigitalocean.com/admin?tls=true&authSource=admin&replicaSet=db-mongodb-nyc3-81705
MONGODB_DATABASE=geststore
JAVA_OPTS=-Xms256m -Xmx512m

# --------------------------------------------
# CÓMO OBTENER TU CONNECTION STRING:
# --------------------------------------------
# 1. Ve a Digital Ocean > Databases > Tu cluster MongoDB
# 2. Click en "Connection Details" 
# 3. Selecciona "Connection String"
# 4. Copia el string y reemplázalo arriba
# 5. Asegúrate de añadir /geststore después del host y antes de ?
#
# Ejemplo de formato correcto:
# mongodb+srv://doadmin:ABCD1234@db-mongodb-nyc1-12345.mongo.ondigitalocean.com/geststore?authSource=admin&replicaSet=db-mongodb-nyc1-12345&tls=true
