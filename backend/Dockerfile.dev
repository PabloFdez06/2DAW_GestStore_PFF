# Dockerfile para desarrollo con hot reload
FROM maven:3.9.5-eclipse-temurin-17-alpine

WORKDIR /app

# Copiar archivos de configuración de Maven
COPY pom.xml .

# Descargar dependencias (se cachea si pom.xml no cambia)
RUN mvn dependency:go-offline -B

# Copiar código fuente
COPY src ./src

# Exponer puerto
EXPOSE 8080

# Comando para desarrollo con hot reload
# Spring Boot DevTools detectará cambios automáticamente
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.jvmArguments=-Xms256m -Xmx512m"]
